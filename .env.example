# =============================================================================
# MDLB WMS — environment variable reference.
# Copy to .env (local dev) or add values in Vercel Project → Settings →
# Environment Variables (production). NEVER commit a file containing real
# values to Git. Both .env and .env.local are listed in .gitignore.
# =============================================================================

# --- Supabase / Vercel Postgres (injected automatically by Vercel integration)
# Add the real values in the Vercel dashboard; use placeholders here only.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWT_SECRET=""

POSTGRES_HOST=""
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DATABASE=""
POSTGRES_URL=""
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# --- Prisma connection strings (REQUIRED) ------------------------------------
# DATABASE_URL  → pooled connection used at runtime (Prisma + PgBouncer).
#                 Set this to your POSTGRES_PRISMA_URL value.
# DIRECT_URL    → non-pooled direct connection used only by the Prisma CLI
#                 (migrations). Set this to your POSTGRES_URL_NON_POOLING value.
#
# In Vercel, add these two lines in Environment Variables:
#   DATABASE_URL  = <paste your POSTGRES_PRISMA_URL value>
#   DIRECT_URL    = <paste your POSTGRES_URL_NON_POOLING value>
DATABASE_URL=""
DIRECT_URL=""

# --- NextAuth (REQUIRED) -----------------------------------------------------
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Canonical public URL of the app — inferred from request headers on Vercel,
# but setting it explicitly is recommended.
NEXTAUTH_URL=""
# Recommended on Vercel / behind a proxy:
AUTH_TRUST_HOST="true"

# --- Authorization -----------------------------------------------------------
# Comma-separated admin email addresses (must be @mdlbeast.com).
ADMIN_EMAILS=""
# Allow crew members to self-register on first login.
ALLOW_CREW_SELF_REGISTER="true"

# --- Seeding (optional — only used by `npm run db:seed`) ---------------------
# Initial password set for the admin user(s) listed in ADMIN_EMAILS.
ADMIN_PASSWORD=""

# --- S3 / R2 image uploads (optional) ----------------------------------------
# Required only if product image uploads are used.
STORAGE_BUCKET=""
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Custom endpoint for Cloudflare R2, MinIO, etc.:
STORAGE_ENDPOINT=""
STORAGE_PUBLIC_BASE_URL=""
