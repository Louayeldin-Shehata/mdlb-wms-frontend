# =============================================================================
# MDLB WMS — single full-stack Next.js app (frontend + API routes together).
# Local: cp .env.example .env  then fill values. Never commit .env / .env.local.
# Vercel: add these in Project → Settings → Environment Variables.
# =============================================================================

# --- Database (REQUIRED) -----------------------------------------------------
# PostgreSQL connection string. Used by Prisma at runtime (src/lib/prisma.ts),
# by the Prisma CLI for migrations (prisma.config.ts), and by the seed script.
# On Vercel, a Postgres integration usually injects this automatically.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# --- NextAuth (REQUIRED in production) --------------------------------------
# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-long-random-string-at-least-32-chars"
# Canonical site URL (no trailing slash). Optional on Vercel: the app infers it
# from request headers, but setting it explicitly is recommended.
NEXTAUTH_URL="http://localhost:3000"
# Trust the deployment proxy headers (recommended on Vercel/behind proxies).
AUTH_TRUST_HOST="true"

# --- Authorization (RECOMMENDED) --------------------------------------------
# Comma-separated admin emails (this app restricts logins to @mdlbeast.com).
ADMIN_EMAILS="admin@mdlbeast.com"
# Allow crew members to self-register on first login.
ALLOW_CREW_SELF_REGISTER="true"

# --- Seeding (OPTIONAL — only used by `npm run db:seed`) ---------------------
# Initial admin password for the bootstrap admin user(s) in ADMIN_EMAILS.
ADMIN_PASSWORD="change-me-after-first-login"

# --- S3 / R2 image uploads (OPTIONAL — required only for product images) -----
# Needed by /api/storage/presign and variant image uploads.
STORAGE_BUCKET=""
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Custom endpoint for S3-compatible providers (Cloudflare R2, MinIO, etc.).
STORAGE_ENDPOINT=""
STORAGE_PUBLIC_BASE_URL=""

# --- Prisma (OPTIONAL) -------------------------------------------------------
# Force the binary query engine if your host requires it.
# PRISMA_CLIENT_ENGINE_TYPE="binary"
